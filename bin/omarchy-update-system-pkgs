#!/bin/bash

# omarchy:summary=Update system packages with DNF
# omarchy:requires-sudo=true

set -e

# The conflict handler's last resort: the updater puts its questions to the
# person running the update instead of answering them itself. Nothing here may
# capture a stream, because an upgrade without -y prompts on stderr. The
# handler has already said why, so no heading here either.
if [[ ${OMARCHY_UPDATE_CONFLICT:-} == 1 && ${OMARCHY_UPDATE_INTERACTIVE:-} == 1 ]]; then
  # DNF only resolves a conflict by erasing a package, and only asks when
  # allowed to: no -y, so the
  # person sees what would be removed and confirms or declines it.
  exec omarchy-update-dnf dnf upgrade --allowerasing
fi

echo -e "\e[32m\nUpdate system packages\e[0m"

errors=$(mktemp)
trap 'rm -f "$errors"' EXIT

# /usr/share/omarchy is wholly Omarchy's; files can land there unowned and would
# otherwise abort the upgrade. RPM refuses to overwrite files it doesn't own,
# so those are cleared by the conflict handler below.
#
# DNF also writes transaction progress and scriptlet output to stderr. Show it
# live while keeping the report for conflict recovery. Drain tee before reading
# that report so the handler always receives the complete error.
exec {progress_fd}> >(tee "$errors" >&2)
progress_pid=$!
updated=0
if LC_ALL=C omarchy-update-dnf dnf upgrade -y 2>&$progress_fd; then
  updated=1
fi
exec {progress_fd}>&-
wait "$progress_pid"
if (( updated )); then
  exit 0
fi

# The handler takes it from here: it clears files dnf doesn't own yet and
# runs this again, and puts a package conflict to whoever started the update.
# Anything else, including a second failure, is for a human.
[[ ${OMARCHY_UPDATE_RETRY:-} != 1 ]] || exit 1
# exec, so the EXIT trap above does not fire and the handler can still read the
# report. It takes over deleting it.
exec env OMARCHY_UPDATE_CONFLICT=1 omarchy-update-system-pkgs-when-conflicted "$errors"
