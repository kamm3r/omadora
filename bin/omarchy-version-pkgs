#!/bin/bash

# omarchy:summary=Print when system packages were last upgraded

dnf history list --limit 1 2>/dev/null | awk 'NR==3 {print $5, $6, $7, $8}' | grep -q . \
  && dnf history list --limit 1 2>/dev/null | awk 'NR==3 {print "Last upgrade:", $5, $6, $7, $8}' \
  || rpm -qa --last 2>/dev/null | head -1 | sed -E 's/^(\S+) +(.+)$/\1 installed \2/'
