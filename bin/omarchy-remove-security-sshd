#!/bin/bash

# omarchy:summary=Disable the OpenSSH server, remove standard firewall rules, and optionally remove authorized keys
# omarchy:requires-sudo=true

set -e

AUTHORIZED_KEYS="$HOME/.ssh/authorized_keys"

# Remove a permanent firewalld entry of the default zone only when it is there.
# A query exits 1 for an absent entry and otherwise only on a real error, which
# stops the removal, so a repeated run stays quiet and a failure is reported.
remove_firewall_entry() {
  local kind=$1 value=$2 status=0
  sudo firewall-cmd --permanent "--query-$kind=$value" >/dev/null || status=$?
  case $status in
    0) sudo firewall-cmd --permanent "--remove-$kind=$value" >/dev/null ;;
    1) ;;
    *) return "$status" ;;
  esac
}

echo -e "\e[32mRemoving SSH server access.\n\e[0m"

echo "Stopping and disabling the OpenSSH server..."
sudo systemctl disable --now sshd.service 2>/dev/null || true

if omarchy-cmd-present firewall-cmd; then
  echo "Removing standard SSH firewall rules..."
  remove_firewall_entry rich-rule 'rule service name="ssh" limit value="25/minute" accept'
  remove_firewall_entry service ssh
  remove_firewall_entry port 22/tcp
  sudo firewall-cmd --reload >/dev/null
  echo "Standard SSH firewall rules removed. Review custom firewall rules separately."
fi

if [[ -s $AUTHORIZED_KEYS ]]; then
  echo
  if gum confirm "Also remove all authorized SSH keys ($AUTHORIZED_KEYS)?"; then
    rm -f "$AUTHORIZED_KEYS"
    echo "Authorized keys removed."
  else
    echo "Keeping authorized keys."
  fi
fi

echo -e "\e[32m\nThe SSH server has been disabled.\e[0m"
echo "The openssh-server package remains installed since openssh also provides the ssh client."
