#!/bin/bash

# omarchy:summary=Remove Dropbox and its bar plugin.
# omarchy:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
omarchy-plugin-disable omarchy.dropbox
omarchy-pkg-drop dropbox dropbox-cli python-gpgme nautilus-dropbox

# Keep the shared tray library; other applications may still need it.

echo ""
echo "Dropbox has been removed."
